{
  "name": "@capsule/ui-kit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Capsule UI - framework-agnostic Tailwind class builders + design tokens (iOS/Material presets). Pure frontend/CSS, touches no native APIs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
