# Per-machine config for the contributor scripts (pnpm dev:*, pnpm with-env).
# Copy to .env.local (git-ignored) and set what differs on your machine; every key is optional
# when your shell already provides it. Values here win over the shell — that is how JAVA_HOME is
# pinned even when a version manager left a stale one. Relative paths resolve from this repo root.

# JDK 17 for Gradle (Temurin 17 recommended).
JAVA_HOME=/path/to/jdk-17

# Android SDK root (contains platform-tools/, emulator/, cmdline-tools/).
ANDROID_HOME=/path/to/Android/sdk

# Where AVDs live — only if not the SDK default (e.g. moved to another drive).
# ANDROID_AVD_HOME=/path/to/avd

# Emulator AVD used by `pnpm dev:emulator` (default CapsuleTest).
# AVD_NAME=CapsuleTest

# Local shell AAR the CLI builds apps against until the Maven AAR is published.
# Default: packages/capsule-android/capsule/build/outputs/aar/capsule-release.aar
# CAPSULE_SHELL_OVERRIDE_PATH=packages/capsule-android/capsule/build/outputs/aar/capsule-release.aar

# The example apps used by `pnpm dev:examples` (default examples/ in this repo).
# CAPSULE_EXAMPLES_DIR=examples
